{
 "book": "Die Psalmen Salomos",
 "title": "Die Psalmen Salomos",
 "note": "Gliederung aus Kautzsch (1900).",
 "sections": [
  {
   "head": "Die Psalmen Salomos",
   "items": [
    {
     "ref": "1:1",
     "text": "Die bittere Frucht des Makkabäerkriegs."
    },
    {
     "ref": "2:1",
     "text": "Jerusalems Schmach und Pompejus' Untergang."
    },
    {
     "ref": "2:1",
     "text": "– Ein Psalm Salomos über Jerusalem."
    },
    {
     "ref": "3:1",
     "text": "Der Frommen und der Gottlosen Ergehen."
    },
    {
     "ref": "3:1",
     "text": "– Ein Psalm Salomos über Gerechte."
    },
    {
     "ref": "4:1",
     "text": "Heuchler im Hohen Rate."
    },
    {
     "ref": "4:1",
     "text": "– Ein Gedicht Salomos gegen die Menschenknechte."
    },
    {
     "ref": "5:1",
     "text": "Gebet um Regen und Speise."
    },
    {
     "ref": "5:1",
     "text": "– Ein Psalm von Salomo."
    },
    {
     "ref": "6:1",
     "text": "Segen des Gebets."
    },
    {
     "ref": "6:1",
     "text": "– In Hoffnung, von Salomo."
    },
    {
     "ref": "7:1",
     "text": "Erbarmen in großer Not."
    },
    {
     "ref": "7:1",
     "text": "– Von Salomo; um Wendung."
    },
    {
     "ref": "8:1",
     "text": "Gerechtes Gericht durch Pompejus."
    },
    {
     "ref": "8:1",
     "text": "– Von Salomo; für den Musikmeister."
    },
    {
     "ref": "9:1",
     "text": "Vergebung für die Frommen."
    },
    {
     "ref": "9:1",
     "text": "– Von Salomo; zur Zurechtweisung."
    },
    {
     "ref": "10:1",
     "text": "Der Frommen Preis."
    },
    {
     "ref": "10:1",
     "text": "– Ein Loblied; von Salomo."
    },
    {
     "ref": "11:1",
     "text": "Sehnsucht nach Israels Erlösung."
    },
    {
     "ref": "11:1",
     "text": "– Von Salomo; auf Erwartung."
    },
    {
     "ref": "12:1",
     "text": "Tod den Verleumdern!"
    },
    {
     "ref": "12:1",
     "text": "– Von Salomo; wider die Zunge der Gottlosen."
    },
    {
     "ref": "13:1",
     "text": "Dank für Rettung."
    },
    {
     "ref": "13:1",
     "text": "– Von Salomo; ein Psalm. Tröstung der Gerechten."
    },
    {
     "ref": "14:1",
     "text": "Der Frommen und der Gottlosen Teil."
    },
    {
     "ref": "14:1",
     "text": "– Loblied von Salomo."
    },
    {
     "ref": "15:1",
     "text": "Der Fromme zum Heil gezeichnet."
    },
    {
     "ref": "15:1",
     "text": "– Ein Psalm von Salomo mit Gesang."
    },
    {
     "ref": "16:1",
     "text": "Dank eines aus dem Sündenschlaf Aufgerüttelten."
    },
    {
     "ref": "16:1",
     "text": "– Ein Lied von Salomo; den Frommen zum Beistand."
    },
    {
     "ref": "17:1",
     "text": "Der entweihte Davidsthron vom Messias neu verherrlicht."
    },
    {
     "ref": "17:1",
     "text": "– Ein Psalm von Salomo mit Gesang; auf den [Messias-]König."
    },
    {
     "ref": "17:30",
     "text": "– Zwischenspiel."
    },
    {
     "ref": "18:1",
     "text": "Der Messias."
    },
    {
     "ref": "18:1",
     "text": "– Ein Psalm von Salomo; noch einmal des [über den?] Gesalbten des EWIGEN."
    },
    {
     "ref": "18:10",
     "text": "– Zwischenspiel."
    }
   ]
  }
 ]
}