{
  "name": "safran",
  "version": "1.4.0",
  "description": "Safran – Sefaria-Texte offline lesen, durchsuchen, herunterladen und eigene Texte für den Upload prüfen",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test.js && node test2.js && node test3.js && node test4.js && node test5.js && node test6.js && node test7.js",
    "dist": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "mammoth": "^1.8.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "de.talmud.safran",
    "productName": "Safran",
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "**/*",
      "!test*.js",
      "!README.md"
    ],
    "icon": "build/icon.png",
    "dmg": {
      "window": {
        "width": 560,
        "height": 430
      },
      "contents": [
        {
          "x": 150,
          "y": 150,
          "type": "file"
        },
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 150,
          "y": 320,
          "type": "file",
          "path": "build/dmg/Safran freischalten.command"
        },
        {
          "x": 410,
          "y": 320,
          "type": "file",
          "path": "build/dmg/Zuerst lesen.txt"
        }
      ]
    }
  }
}
