{
  "name": "sefaria-mac",
  "version": "0.1.0",
  "description": "Sefaria lesen, durchsuchen, herunterladen und eigene Texte für den Upload prüfen",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test.js && node test2.js && node test3.js && node test4.js && node test5.js && node test6.js",
    "dist": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "mammoth": "^1.8.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "local.sefaria.mac",
    "productName": "Sefaria Mac",
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "**/*",
      "!test*.js",
      "!README.md"
    ],
    "icon": "build/icon.png"
  }
}